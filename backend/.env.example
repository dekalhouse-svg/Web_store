DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_PATH=/absolute/path/to/db.sqlite3
DJANGO_TIME_ZONE=Africa/Lubumbashi
DEFAULT_FROM_EMAIL=no-reply@your-domain.example

# V1 : false = connexion sans vérification e-mail
REQUIRE_EMAIL_VERIFICATION=false

# V2 : renseigner lorsque la clé SMTP/messagerie est disponible
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@webstore.local
