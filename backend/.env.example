DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_PATH=/absolute/path/to/db.sqlite3
DJANGO_TIME_ZONE=Africa/Lubumbashi

# Brevo : ajoute la clé API dans Render, jamais dans le dépôt Git.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_NAME=WEB STORE
DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.com

# Vérification obligatoire des e-mails à l'inscription (true/false).
REQUIRE_EMAIL_VERIFICATION=false

# Durées et protections des codes à usage unique.
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_PASSWORD_RESET_CODE_TTL_MINUTES=30
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_RESEND_COOLDOWN_SECONDS=60

# SMTP facultatif : utiliser EMAIL_PROVIDER=smtp si nécessaire.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
